# ==============================================================================
# AI & IoT Leakage Detection in Electric Pole and Life Safety - Environment Config
# NOTE: DO NOT COMMIT REAL CREDENTIALS OR SECRETS TO VERSION CONTROL.
# Copy this file to .env and replace placeholders with your actual configuration.
# ==============================================================================

# Application Runtime Configuration
APP_NAME="Electric Pole Leakage & Safety Platform"
APP_ENV="development"                  # options: development, testing, production
DEBUG=true
API_V1_STR="/api/v1"
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# System Operating Mode (Hardware vs Simulation)
# Set to 'true' to allow backend to consume simulated IoT telemetry data
# Set to 'false' in production when connecting exclusively to physical ESP32 devices
SIMULATION_MODE=true
SIMULATION_POLE_COUNT=5
TELEMETRY_INTERVAL_SECONDS=5

# PostgreSQL Database
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="your_postgres_password_here"
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_DB="electric_pole_safety_db"
DATABASE_URL="postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_SERVER}:${POSTGRES_PORT}/${POSTGRES_DB}"

# IoT / MQTT Settings (Optional - if using MQTT broker instead of direct HTTP)
MQTT_BROKER_URL="localhost"
MQTT_BROKER_PORT=1883
MQTT_TOPIC_TELEMETRY="poles/telemetry"
MQTT_TOPIC_ALERTS="poles/alerts"
MQTT_CLIENT_ID="fastapi_safety_core"
MQTT_USERNAME=""
MQTT_PASSWORD=""

# AI / ML Model Configurations
ML_MODELS_DIR="./ai/models"
LEAKAGE_CLASSIFIER_MODEL_PATH="./ai/models/leakage_rf_model.joblib"
LEAKAGE_SCALER_PATH="./ai/models/scaler.joblib"
MODEL_CONFIDENCE_THRESHOLD=0.85

# Computer Vision (YOLO) Configurations
YOLO_MODEL_PATH="./ai/models/yolov8_pole_hazard.pt"
CV_DEVICE="cpu"                        # options: cpu, cuda, 0
CV_CONFIDENCE_THRESHOLD=0.50
CV_SAVE_EVIDENCE_DIR="./backend/static/evidence"

# RAG & ChromaDB Vector Store
CHROMA_PERSIST_DIR="./rag/chroma_db"
CHROMA_COLLECTION_NAME="electrical_safety_regulations"
EMBEDDING_MODEL_NAME="sentence-transformers/all-MiniLM-L6-v2"

# LLM Provider Configuration (Flexible & Configurable)
# Supported options: gemini, openai, groq, ollama, local
LLM_PROVIDER="gemini"
LLM_MODEL="gemini-1.5-flash"
LLM_API_KEY="your_api_key_here"
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024

# Alert & Notification Gateways (Placeholders)
NOTIFICATION_ENABLED=false
FCM_SERVER_KEY="your_firebase_cloud_messaging_key_here"
TWILIO_ACCOUNT_SID="your_twilio_account_sid_here"
TWILIO_AUTH_TOKEN="your_twilio_auth_token_here"
TWILIO_FROM_NUMBER="+10000000000"
EMERGENCY_DISPATCH_PHONE="+910000000000"

# CORS Configuration (Allowed origins for Web Dashboard and Mobile client)
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173"
